{
  "$schema": "https://opencode.ai/config.json",

  "mcp": {
    "GitHub": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PAT_TOKEN}"
      }
    }
  },

  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git blame *": "allow",
      "git ls-files *": "allow",
      "git branch *": "allow",
      "git remote *": "allow",
      "ls *": "allow",
      "find *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "tree *": "allow",
      "pwd": "allow",
      "which *": "allow",
      "echo *": "allow"
    }
  }
}
